# =============================================================================
# prometheus.config
# Konfigurasi tambahan Prometheus: storage retention, web interface,
# dan parameter runtime untuk monitoring mushroom_model.
# =============================================================================

# ── Storage Configuration ─────────────────────────────────────────────────────
[storage]
  # Lokasi penyimpanan data time-series
  tsdb.path = "/prometheus"

  # Durasi retensi data (berapa lama data disimpan)
  tsdb.retention.time = "15d"

  # Maksimal ukuran storage
  tsdb.retention.size = "512MB"

# ── Web Interface Configuration ───────────────────────────────────────────────
[web]
  # Port Prometheus web UI
  listen-address = "0.0.0.0:9090"

  # Path prefix (biarkan kosong untuk root)
  external-url = ""

  # Enable lifecycle API (untuk reload config tanpa restart)
  enable-lifecycle = true

  # Enable admin API
  enable-admin-api = false

# ── Query Configuration ───────────────────────────────────────────────────────
[query]
  # Timeout maksimal untuk setiap query
  timeout = "2m"

  # Maksimal sampel yang dikembalikan per query
  max-samples = 50000000

# ── Log Configuration ─────────────────────────────────────────────────────────
[log]
  level = "info"
  format = "logfmt"
